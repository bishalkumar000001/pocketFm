# Required
BOT_TOKEN=123456789:replace_with_your_bot_token
DATABASE_URL=postgresql://username:password@host:5432/database

# Comma-separated Telegram numeric user IDs
ADMIN_IDS=123456789

# Catalog source: public Pocket FM web pages; no API key is required.

# Limits / worker settings
MAX_RANGE=100
MAX_CONCURRENT_JOBS=1
REQUEST_TIMEOUT=60
MAX_RETRIES=3
LOG_LEVEL=INFO
